{
  "name": "@numeracode/whimsy-file-browser-icons",
  "version": "2.3.2",
  "description": "FontAwesome icon component for the Numeracode Whimsy file browser",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve --sourcemap --clean --external react --external react-dom --external @numeracode/whimsy-file-browser",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --sourcemap --watch --external react --external react-dom --external @numeracode/whimsy-file-browser",
    "lint": "npm run typecheck",
    "test": "vitest run --passWithNoTests --globals --environment jsdom",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "printWidth": 88
  },
  "devDependencies": {
    "@testing-library/react": "^11.2.5",
    "@types/react": "^17.0.3",
    "@types/react-dom": "^17.0.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@numeracode/whimsy-file-browser": "^2.3.2",
    "tslib": "^2.8.1"
  },
  "homepage": "https://github.com/Numeracode/whimsy-file-browser",
  "author": {
    "name": "Numeracode",
    "url": "https://github.com/Numeracode"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Numeracode/whimsy-file-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Numeracode/whimsy-file-browser/issues"
  },
  "keywords": [
    "file",
    "whimsy",
    "file-browser",
    "file-dialog",
    "react-component"
  ]
}
