{
  "name": "@numeracode/whimsy-file-browser",
  "version": "2.3.2",
  "description": "Numeracode-maintained React file browser package for Whimsy",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.mjs",
      "require": "./dist/preview.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/preview.ts --format cjs,esm --dts --sourcemap --clean --external react --external react-dom",
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts src/preview.ts --format cjs,esm --dts --sourcemap --watch --external react --external react-dom",
    "lint": "npm run typecheck",
    "test": "vitest run --passWithNoTests --globals --environment jsdom",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "printWidth": 88
  },
  "devDependencies": {
    "@testing-library/react": "^11.2.5",
    "@types/react": "^17.0.3",
    "@types/react-dom": "^17.0.2",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-is": "^17.0.1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.5.0",
    "@types/fuzzy-search": "^2.1.0",
    "@types/memoizee": "^0.4.5",
    "@types/react-redux": "^7.1.16",
    "@types/react-virtualized-auto-sizer": "^1.0.0",
    "@types/react-window": "^1.8.2",
    "@types/redux-watch": "^1.1.0",
    "@types/shortid": "^0.0.29",
    "classnames": "^2.2.6",
    "deepmerge": "^4.2.2",
    "exact-trie": "^1.0.13",
    "fast-sort": "^2.2.0",
    "filesize": "^6.1.0",
    "fuzzy-search": "^3.2.1",
    "hotkeys-js": "^3.8.3",
    "react-dnd": "11",
    "react-dnd-html5-backend": "11",
    "react-intl": "^5.13.2",
    "react-redux": "^7.2.2",
    "react-virtualized-auto-sizer": "^1.0.5",
    "react-window": "^1.8.6",
    "redux-watch": "^1.2.0",
    "shortid": "^2.2.16",
    "tslib": "^2.8.1",
    "tsdef": "^0.0.14"
  },
  "homepage": "https://github.com/Numeracode/whimsy-file-browser",
  "author": {
    "name": "Numeracode",
    "url": "https://github.com/Numeracode"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Numeracode/whimsy-file-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Numeracode/whimsy-file-browser/issues"
  },
  "keywords": [
    "file",
    "whimsy",
    "file-browser",
    "file-dialog",
    "react-component"
  ]
}
